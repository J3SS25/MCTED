{
  "name": "mcteb",
  "private": true,
  "version": "0.1.0",
  "description": "Municipal Community Tool and Equipment Bank — Municipality of Basco, Batanes",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mcteb/web --filter @mcteb/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @mcteb/api db:migrate",
    "db:seed": "pnpm --filter @mcteb/api db:seed",
    "audit": "pnpm audit --prod"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "eslint": "9.27.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "prettier": "3.5.3",
    "typescript": "5.8.3"
  }
}

